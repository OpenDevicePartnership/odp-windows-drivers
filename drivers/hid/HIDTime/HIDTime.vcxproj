<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="12.0"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <ItemGroup Label="ProjectConfigurations">
        <ProjectConfiguration Include="Debug|ARM64">
            <Configuration>Debug</Configuration>
            <Platform>ARM64</Platform>
        </ProjectConfiguration>
        <ProjectConfiguration Include="Release|ARM64">
            <Configuration>Release</Configuration>
            <Platform>ARM64</Platform>
        </ProjectConfiguration>
        <ProjectConfiguration Include="Debug|x64">
            <Configuration>Debug</Configuration>
            <Platform>x64</Platform>
        </ProjectConfiguration>
        <ProjectConfiguration Include="Release|x64">
            <Configuration>Release</Configuration>
            <Platform>x64</Platform>
        </ProjectConfiguration>
    </ItemGroup>
    <PropertyGroup Label="Globals">
        <ProjectGuid>{7B3E9A21-4C6D-4F1A-9E2B-1A2B3C4D5E6F}</ProjectGuid>
        <RootNamespace>$(MSBuildProjectName)</RootNamespace>
        <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
        <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
        <Platform Condition="'$(Platform)' == ''">x64</Platform>
        <SampleGuid>{8C4FAB32-5D7E-4A2B-8F3C-2B3C4D5E6F70}</SampleGuid>
        <WindowsTargetPlatformVersion>$(LatestTargetPlatformVersion)</WindowsTargetPlatformVersion>
        <OutDir>$(IntDir)</OutDir>
        <TargetName>HIDTime</TargetName>
        <TargetVersion>Windows10</TargetVersion>
        <DriverTargetPlatform>Universal</DriverTargetPlatform>
        <DriverType>KMDF</DriverType>
        <ConfigurationType>Driver</ConfigurationType>
        <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    </PropertyGroup>
    <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
    <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Release'">
        <UseDebugLibraries>False</UseDebugLibraries>
    </PropertyGroup>
    <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Debug'">
        <UseDebugLibraries>True</UseDebugLibraries>
    </PropertyGroup>
    <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
    <ImportGroup Label="PropertySheets">
        <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
    </ImportGroup>
    <ItemGroup Label="WrappedTaskItems">
        <Inf Include=".\HIDTime.inx">
            <Architecture>$(InfArch)</Architecture>
            <SpecifyArchitecture>true</SpecifyArchitecture>
            <CopyOutput>.\$(IntDir)\HIDTime.inf</CopyOutput>
        </Inf>
    </ItemGroup>
    <ItemDefinitionGroup>
        <ClCompile>
            <TreatWarningAsError>true</TreatWarningAsError>
            <WarningLevel>Level4</WarningLevel>
            <ExceptionHandling>false</ExceptionHandling>
            <LanguageStandard>stdcpp20</LanguageStandard>
            <!-- WDK headers are not warning-clean; scope our warnings to our own sources. -->
            <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
            <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
            <!-- C4062 (unhandled enumerator in a switch with no default) is off by default even at /W4. -->
            <AdditionalOptions>/we4062 %(AdditionalOptions)</AdditionalOptions>
        </ClCompile>
        <Link>
            <!-- HidP_* parsing routines are exported by hidparse.sys -->
            <AdditionalDependencies>$(DDK_LIB_PATH)hidparse.lib;%(AdditionalDependencies)</AdditionalDependencies>
        </Link>
        <DriverSign>
            <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
        </DriverSign>
    </ItemDefinitionGroup>
    <ItemGroup>
        <ClCompile Include="driver.cpp" />
        <ClCompile Include="device.cpp" />
        <ClCompile Include="guid.cpp" />
        <ClCompile Include="memory_km.cpp" />
        <ClCompile Include="Trace.cpp" />
        <ResourceCompile Include="HIDTime.rc" />
    </ItemGroup>
    <ItemGroup>
        <Inf Exclude="@(Inf)" Include="*.inf" />
        <FilesToPackage Include="$(TargetPath)" Condition="'$(ConfigurationType)'=='Driver' or '$(ConfigurationType)'=='DynamicLibrary'" />
    </ItemGroup>
    <ItemGroup>
        <ClInclude Exclude="@(ClInclude)" Include="*.h;*.hpp;*.hxx;*.hm;*.inl;*.xsd" />
    </ItemGroup>
    <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
    <PropertyGroup>
        <WilPropsFilePath>$(ProjectDir)packages\Microsoft.Windows.ImplementationLibrary.1.0.260126.7\build\native\Microsoft.Windows.ImplementationLibrary.targets</WilPropsFilePath>
    </PropertyGroup>
    <Import Project="$(WilPropsFilePath)" Condition="Exists('$(WilPropsFilePath)')" />
    <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
        <Error Condition="!Exists('$(WilPropsFilePath)')" Text="Restore NuGet packages before building. Missing Microsoft.Windows.ImplementationLibrary 1.0.260126.7." />
    </Target>
</Project>
